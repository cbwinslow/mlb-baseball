# Postgres connection. Bare-metal Postgres is the default assumption (see docs/DECISIONS.md ADR-002) —
# point this at whatever Postgres instance you actually run; the code has no opinion on how it's hosted.
DATABASE_URL=postgresql://mlb:password@localhost:5432/mlb

# Kalshi API key (free account required for read-only market data; see docs/DATA_SOURCES.md).
# Leave unset until the Kalshi connector is built.
KALSHI_API_KEY=
