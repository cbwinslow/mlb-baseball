# Postgres connection. Bare-metal Postgres is the default assumption (see docs/DECISIONS.md ADR-002) —
# point this at whatever Postgres instance you actually run; the code has no opinion on how it's hosted.
DATABASE_URL=postgresql://mlb:password@localhost:5432/mlb

# Disposable integration-test database. It must be a separate, pre-created
# database; pytest never creates one and must never target DATABASE_URL.
TEST_DATABASE_URL=postgresql://mlb:password@localhost:5432/mlb_test

# Optional direct overrides for values in mlb.toml. Keep database credentials
# here or in your shell/secret manager, never in mlb.toml.
# MLB_CONFIG=/absolute/path/to/mlb.toml
# MLB_DOWNLOAD_DIR=/path/to/downloads
# MLB_LOG_DIR=/path/to/logs
# MLB_ANALYTICS_WORKERS=8
# MLB_ANALYTICS_START_YEAR=1950
# MLB_ANALYTICS_END_YEAR=2026
# MLB_RETRY_ATTEMPTS=3
# MLB_BACKOFF_SECONDS=1.0
# MLB_REQUEST_TIMEOUT_SECONDS=5

# Kalshi API key (free account required for read-only market data; see docs/DATA_SOURCES.md).
# Leave unset until the Kalshi connector is built.
KALSHI_API_KEY=
