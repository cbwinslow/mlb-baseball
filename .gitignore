# Real pg_dump output (mlb_baseball/backup.py) -- can be tens of GB against
# production; never belongs in git. The one pre-existing small schema-only
# snapshot already tracked (backups/mlb_schema_20260807.sql) is left as-is,
# not retroactively removed from history.
/backups/*.sql
!/backups/mlb_schema_20260807.sql

